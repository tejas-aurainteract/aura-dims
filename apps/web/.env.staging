# STAGING TARGET: aura-dims-staging
# Strict Rule: Zero secret keys or private service account tokens in client env.
# ==============================================================================

# Live Staging Firebase Project Configuration
VITE_FIREBASE_PROJECT_ID=aura-dims-staging
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderStagingApiKeyToReplaceOnApproval
VITE_FIREBASE_AUTH_DOMAIN=aura-dims-staging.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=aura-dims-staging.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=

# Strict Live Cloud Mode (Emulators Disabled)
VITE_USE_FIREBASE_EMULATOR=false

# System Configuration
VITE_APP_TIMEZONE=Asia/Kolkata
VITE_APP_DEFAULT_LANG=en

