# Live Production Firebase Project Configuration
VITE_FIREBASE_PROJECT_ID=aura-dims-prod
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderProductionApiKeyToReplaceOnApproval
VITE_FIREBASE_AUTH_DOMAIN=aura-dims-prod.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=aura-dims-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=

# Strict Live Cloud Mode (Emulators Disabled)
VITE_USE_FIREBASE_EMULATOR=false

# System Configuration
VITE_APP_TIMEZONE=Asia/Kolkata
VITE_APP_DEFAULT_LANG=en

