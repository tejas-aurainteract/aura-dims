{
  "name": "aura-dims-monorepos",
  "version": "0.1.0",
  "private": true,
  "description": "Aura Digital Information Management System (Aura DIMS) - Monorepo foundation",
  "author": "Aurainteract Private Limited",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k -n \"EMULATORS,WEB\" -c \"yellow,cyan\" \"pnpm run emulators:start\" \"pnpm --filter @aura-dims/web dev\"",
    "build": "pnpm --filter @aura-dims/display-schema build && pnpm --filter @aura-dims/functions build && pnpm --filter @aura-dims/web build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm run test:rules && pnpm --filter @aura-dims/web test:unit",
    "test:rules": "vitest run tests/rules",
    "test:e2e": "playwright test",
    "emulators:start": "firebase emulators:start --project demo-aura-dims --import=./firebase/emulators/data --export-on-exit=./firebase/emulators/data",
    "emulators:start:blank": "firebase emulators:start --project demo-aura-dims",
    "emulators:export": "firebase emulators:export ./firebase/emulators/data --project demo-aura-dims --force",
    "bootstrap:admin": "node --experimental-strip-types scripts/bootstrap-admin.ts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "concurrently": "^9.1.2",
    "firebase": "^11.3.1",
    "firebase-admin": "^13.1.0",
    "firebase-tools": "^15.34.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6",
    "wait-on": "^8.0.2"
  },
  "packageManager": "pnpm@10.30.1"
}
