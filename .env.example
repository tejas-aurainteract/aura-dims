# ==============================================================================
# Aura DIMS - Environment Configuration Example
# Company: Aurainteract Private Limited
# Product: Aura Digital Information Management System (Aura DIMS)
# ==============================================================================
# Copy this file to .env.local (or apps/web/.env.local) for local configuration.
# NO REAL SECRETS OR LIVE API KEYS SHOULD BE COMMITTED TO THIS EXAMPLE FILE.
# ==============================================================================

# Firebase Project Configuration (Dummy / Placeholder values)
VITE_FIREBASE_PROJECT_ID=demo-aura-dims
VITE_FIREBASE_API_KEY=your-api-key-placeholder
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Emulator Flags & Hosts (Defaults to true for local development)
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001

# System Timezone and Default Language
VITE_APP_TIMEZONE=Asia/Kolkata
VITE_APP_DEFAULT_LANG=en
