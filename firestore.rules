rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Aura DIMS - Role-Based Access Control & Departmental Governance
    // Company: Aurainteract Private Limited
    // Product: Aura Digital Information Management System (Aura DIMS)

    // Helper: Check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Fetch caller's authoritative user record
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Validate caller is an active System Administrator
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role == 'admin' && request.auth.token.active == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin' &&
         getUserData().status == 'active')
      );
    }

    // Helper: Validate caller is an active Department Head
    function isDepartmentHead() {
      return isAuthenticated() && (
        (request.auth.token.role == 'department_head' && request.auth.token.active == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'department_head' &&
         getUserData().status == 'active')
      );
    }

    // Helper: Retrieve caller's assigned department ID
    function getCallerDepartmentId() {
      return request.auth.token.departmentId != null
        ? request.auth.token.departmentId
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
           ? getUserData().departmentId
           : null);
    }

    // Users Collection: /users/{userId}
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isDepartmentHead() && resource.data.departmentId != null && resource.data.departmentId == getCallerDepartmentId())
      );
      allow write: if false;
    }

    // Departments Collection: /departments/{departmentId}
    match /departments/{departmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.status == 'active') ||
        (isDepartmentHead() && resource.data.id == getCallerDepartmentId())
      );
      allow write: if false;
    }

    // Assets Collection: /assets/{assetId}
    match /assets/{assetId} {
      // 1. Admin can read any asset across departments.
      // 2. Department Head can read assets in their own department.
      // 3. Staging/awaiting_upload assets can be read by their creator or Admin.
      // 4. Cross-department reads are strictly denied.
      // 5. Unauthenticated callers or device identities are denied.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDepartmentHead() && resource.data.departmentId == getCallerDepartmentId()) ||
        (resource.data.status == 'awaiting_upload' && resource.data.ownerId == request.auth.uid)
      );

      // All client writes are strictly disallowed.
      // Upload initiation, validation, metadata edits, archiving, and cleanup must be executed through Cloud Functions.
      allow write: if false;
    }

    // Designs Collection: /designs/{designId}
    match /designs/{designId} {
      // 1. Admin can read designs across all departments.
      // 2. Department Head can read designs strictly in their active assigned department.
      // 3. Cross-department reads are strictly denied.
      // 4. Unauthenticated callers or device identities are denied.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDepartmentHead() && resource.data.departmentId == getCallerDepartmentId())
      );

      // Direct client writes are forbidden. Mutations, revisions, schema validation,
      // and asset reference integrity are managed via Cloud Functions.
      allow write: if false;
    }

    // Templates Collection: /templates/{templateId}
    match /templates/{templateId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.scope == 'global' ||
        (isDepartmentHead() && resource.data.departmentId == getCallerDepartmentId())
      );
      allow write: if false;
    }

    // Design Revisions Collection: /designRevisions/{revisionId}
    match /designRevisions/{revisionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDepartmentHead() && resource.data.departmentId == getCallerDepartmentId())
      );
      allow write: if false;
    }

    // Playlists Collection: /playlists/{playlistId}
    match /playlists/{playlistId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDepartmentHead() && resource.data.departmentId == getCallerDepartmentId())
      );
      allow write: if false;
    }

    // Playlist Revisions Collection: /playlistRevisions/{revisionId}
    match /playlistRevisions/{revisionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDepartmentHead() && resource.data.departmentId == getCallerDepartmentId())
      );
      allow write: if false;
    }

    // Approvals Collection: /approvals/{approvalId}
    match /approvals/{approvalId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDepartmentHead() && resource.data.departmentId == getCallerDepartmentId())
      );
      allow write: if false;
    }

    // Schedules Collection: /schedules/{scheduleId}
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDepartmentHead() && resource.data.departmentId == getCallerDepartmentId())
      );
      allow write: if false;
    }

    // Publications Collection: /publications/{publicationId}
    match /publications/{publicationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDepartmentHead() && resource.data.departmentId == getCallerDepartmentId())
      );
      allow write: if false;
    }

    // Digital Displays Collection: /displays/{displayId}
    match /displays/{displayId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDepartmentHead() && resource.data.departmentId == getCallerDepartmentId())
      );
      allow write: if false;
    }

    // Display Assignments Collection: /displayAssignments/{assignmentId}
    match /displayAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDepartmentHead() && resource.data.departmentId == getCallerDepartmentId())
      );
      allow write: if false;
    }

    // Audit Events Collection: /auditEvents/{eventId}
    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // System Metadata Collection: /systemMetadata/{docId}
    match /systemMetadata/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // All other collections remain strictly denied until their respective milestones.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
