[Unit]
Description=Aura DIMS Digital Display Local Agent
Documentation=https://aurainteract.com/docs/aura-dims
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=auradims
Group=auradims
WorkingDirectory=/opt/aura-dims
Environment=NODE_ENV=production
Environment=AURA_DATA_DIR=/var/lib/auradims
Environment=AURA_PLAYER_PORT=8090
Environment=FIREBASE_PROJECT_ID=demo-aura-dims
ExecStart=/usr/bin/node /opt/aura-dims/player/dist/agent/index.js
Restart=always
RestartSec=5s
TimeoutStopSec=15s
WatchdogSec=60s

# Hardening & Security Sandbox
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/auradims /var/log/auradims
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=auradims-agent

[Install]
WantedBy=multi-user.target

